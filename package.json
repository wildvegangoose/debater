    "@xyflow/react": "^12.4.0",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^0.475.0",
    "posthog-js": "^1.455.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
